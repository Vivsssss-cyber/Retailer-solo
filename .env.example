# Copy to .env.local and adjust. Never commit real secrets.

# --- Frontend client ---
# "true" (default) = localStorage mockAdapter
# "false" = live REST client against Next.js API (or remote API_URL)
NEXT_PUBLIC_USE_MOCK=true

# Backend base URL (no trailing slash).
# Leave empty when USE_MOCK=false to hit same-origin /api/retailer-challenge/*
# NEXT_PUBLIC_API_URL=http://localhost:3000
# NEXT_PUBLIC_API_URL=https://api.example.com

# --- Server store (optional) ---
# Directory for retailer-challenge.json persistence (default: ./.data)
# On Render/Railway with a disk, use the mount path:
# DATA_DIR=/var/data

# Force in-memory store (tests set this automatically)
# RETAILER_STORE_MEMORY=1

# --- Live deploy (Render Starter) ---
# NEXT_PUBLIC_USE_MOCK=false
# DATA_DIR=/var/data
# Leave NEXT_PUBLIC_API_URL unset for same-origin API.
# See docs/DEPLOY.md
